# Copy this file to .env and fill in real values.
# Never commit .env — it contains secrets.
#
# Get the Supabase values from: Supabase Dashboard → Project Settings → API

PORT=3000

# Project URL — ends with .supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable / anon key — safe to use in the browser
SUPABASE_ANON_KEY=your-supabase-publishable-key

# SECRET key (sb_secret_...) — server-side ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key

# Bootstrapped admin — created or password-reset on every server startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-10-characters